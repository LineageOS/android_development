digraph G {
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif"];
    edge [fontname="Helvetica,Arial,sans-serif"];

    pad=0.6;

    // Axes
    origin [shape=point, width=0, pos="0,0!"];
    y_top  [shape=point, width=0, pos="0,3.5!"];
    x_end  [shape=point, width=0, pos="5.5,0!"];

    edge [color="#5F6368", penwidth=2, arrowhead=normal];
    origin -> y_top;
    origin -> x_end;

    // Axis Labels
    node [shape=none, fontsize=14, fontcolor="#3C4043"];
    y_label [label="Performance", pos="-0.8,3.3!"];
    x_label [label="Memory Use", pos="4.5,-0.4!"];

    // The Line Points
    node [shape=point, width=0];
    p1 [pos="0,2.5!"];
    p2 [pos="3.5,2.5!"];
    p3 [pos="4.8,0.2!"];

    // Data Line segments
    edge [arrowhead=none, penwidth=6];
    p1 -> p2 [color="#1A73E8"];
    p2 -> p3 [color="#D93025"];

    // Floating Labels (positioned to avoid overlap)
    node [shape=none, fontsize=12];

    stable_text [label="Stable Range", fontcolor="#1A73E8", pos="1.75,2.9!"];
    cliff_text  [label="THE CLIFF", fontcolor="#D93025", fontname="Helvetica-Bold", fontsize=15, pos="5.0,1.5!"];

    // Help text
    thrash_text [label="Thrashing &\nOOM Kills", fontcolor="#70757A", fontsize=10, pos="5.2,0.9!"];
}
