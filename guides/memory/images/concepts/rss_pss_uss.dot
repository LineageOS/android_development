digraph G {
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif"];
    edge [fontname="Helvetica,Arial,sans-serif"];

    overlap=true;
    sep="+30";
    pad=0.8;

    // The two processes in a classic Venn overlap
    // ProcA is at 0,0 with radius 2.0. ProcB is at 2.2,0 with radius 2.0.
    node [shape=circle, width=4.0, style=filled];

    // Process A (Blue)
    ProcA [label="", fillcolor="#4285F422", color="#4285F4", penwidth=5, pos="0,0!"];

    // Process B (Red)
    ProcB [label="", fillcolor="#EA433511", color="#EA4335", penwidth=2, pos="2.2,0!"];

    // Regional Labels (Inside the circles)
    node [shape=none, style=none, fontcolor="#5F6368", fontsize=13];
    TextUnique [label="Unique\nMemory", pos="-0.9,0!"];
    TextShared [label="Shared\nMemory", pos="1.1,0!"];

    // Circle Labels (Process Names)
    node [fontsize=20, fontname="Helvetica-Bold"];
    ProcALabel [label="Process A", fontcolor="#1A73E8", pos="-0.5,2.5!"];
    ProcBLabel [label="Process B", fontcolor="#D93025", pos="2.7,2.5!"];

    // Metric Callout Boxes (making them pop)
    node [shape=box, style="filled,rounded", color="#BDC1C6", fillcolor="#F8F9FA", fontsize=14, fontname="Helvetica-Bold", margin="0.15,0.1"];

    USS [label="USS\n(Unique only)", fontcolor="#185ABC", pos="-3.5,1.2!"];
    RSS [label="RSS\n(Total Set)", fontcolor="#202124", pos="-3.5,-1.2!"];
    PSS [label="PSS\n(Unique + Share of Shared)", fontcolor="#B21417", pos="1.1,3.5!"];

    // Callout Arrows
    edge [penwidth=2.5, arrowhead=normal, arrowsize=1.2];

    // USS points to the unique region
    USS -> TextUnique [color="#4285F4"];

    // RSS points to the circle boundary representing the whole set
    RSS -> ProcA [color="#5F6368", arrowhead=dot];

    // PSS points to both components
    edge [penwidth=2, style=dashed, color="#B21417"];
    PSS -> TextUnique;
    PSS -> TextShared;
}
