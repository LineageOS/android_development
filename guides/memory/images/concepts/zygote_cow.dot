digraph G {
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif", shape=box, style="rounded,filled"];
    edge [fontname="Helvetica", fontsize=10];
    rankdir=TB;

    subgraph cluster_physical {
        label = "Physical RAM (Pages)";
        style = "dashed";
        pA [label="Page A\n(Preloaded Framework)", fillcolor="#ccebc5"];
        pB [label="Page B\n(Preloaded Framework)", fillcolor="#ccebc5"];
        pC [label="Page C\n(Original Zygote State)", fillcolor="#ccebc5"];
        pC_prime [label="Page C'\n(Modified App State)", fillcolor="#fbb4ae"];
        {rank=same; pA; pB; pC; pC_prime;}
    }

    subgraph cluster_zygote {
        label = "Zygote Process";
        style = "rounded,filled";
        fillcolor = "#E0F2F1";
        z_map [label="Zygote Address Space", shape=record, label="<f1> Page A Mapping|<f2> Page B Mapping|<f3> Page C Mapping"];
    }

    subgraph cluster_app {
        label = "App Process (Forked)";
        style = "rounded,filled";
        fillcolor = "#E8EAF6";
        a_map [label="App Address Space", shape=record, label="<f1> Page A Mapping|<f2> Page B Mapping|<f3> Page C' Mapping"];
    }

    // Mappings
    z_map:f1 -> pA;
    z_map:f2 -> pB;
    z_map:f3 -> pC;

    a_map:f1 -> pA [label=" shared"];
    a_map:f2 -> pB [label=" shared"];
    a_map:f3 -> pC_prime [label=" private dirty", color="#e41a1c", penwidth=2];

    pC -> pC_prime [label=" copy-on-write triggered\nby app modification", style=dotted, color="#e41a1c"];
}
