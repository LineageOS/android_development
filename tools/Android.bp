package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "development_tools_license",
    ],
}

license {
    name: "development_tools_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "legacy_unencumbered",
    ],
}

subdirs = ["*"]

// For packaging sdk-repo-platforms*.zip
genrule {
    name: "sdk_platforms_emulator_skins",
    tools: ["soong_zip"],
    srcs: [
        "emulator/skins/**/*",
    ],
    out: [
        "sdk_platforms_emulator_skins.zip",
    ],
    cmd: "mkdir -p $(genDir)/out/skins/ && " +
        "cp -r development/tools/emulator/skins/* $(genDir)/out/skins/ && " +
        "rm -f $(genDir)/out/skins/NOTICE.txt && " +
        "$(location soong_zip) -o $(out) -C $(genDir)/out -D $(genDir)/out",
}

genrule {
    name: "sdk_platforms_templates",
    tools: ["soong_zip"],
    srcs: [
        "templates/**/*",
    ],
    out: [
        "sdk_platforms_templates.zip",
    ],
    cmd: "$(location soong_zip) -o $(out) -C development/tools -D development/tools/templates",
}
