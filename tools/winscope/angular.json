{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "winscope": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/winscope",
            "index": "src/index.html",
            "main": "src/main_dev.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.dev.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              { "glob": "*", "input": "deps_build/trace_processor/to_be_served/", "output": "/" },
              { "glob": "winscope_proxy.py", "input": "src/adb/", "output": "/" },
              { "glob": "logo_page_tab.svg", "input": "src/", "output": "/" },
              { "glob": "logo_light_mode.svg", "input": "src/", "output": "/" },
              { "glob": "logo_dark_mode.svg", "input": "src/", "output": "/" },
              { "glob": "cube_partial_shade.svg", "input": "src/viewers/components/rects/", "output": "/" },
              { "glob": "cube_full_shade.svg", "input": "src/viewers/components/rects/", "output": "/" },
              { "glob": "trackpad_right_click.svg", "input": "src/app/components/", "output": "/" },
              { "glob": "trackpad_vertical_scroll.svg", "input": "src/app/components/", "output": "/" },
              { "glob": "trackpad_horizontal_scroll.svg", "input": "src/app/components/", "output": "/" }
            ],
            "styles": [
              "src/styles/material-theme.scss",
              "src/styles/styles.css"
            ],
            "scripts": [],
            "sourceMap": true,
            "optimization": false,
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/main_dev.ts",
                  "with": "src/main_prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "tsConfig": "tsconfig.prod.json",
              "outputPath": "dist/prod"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "winscope:build",
            "port": 8080,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "winscope:build:production",
              "port": 8080
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "winscope:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/main_unit_test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.karma.json",
            "karmaConfig": "karma.config.dev.js",
            "styles": [
              "src/styles/material-theme.scss",
              "src/styles/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "ci": {
              "codeCoverage": true,
              "karmaConfig": "karma.config.ci.js"
            }
          }
        }
      }
    },
    "remote-tool-mock": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src/test/remote_tool_mock",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/remote_tool_mock",
            "index": "src/test/remote_tool_mock/index.html",
            "main": "src/test/remote_tool_mock/main.ts",
            "polyfills": "src/test/remote_tool_mock/polyfills.ts",
            "tsConfig": "src/test/remote_tool_mock/tsconfig.remote_tool.json",
            "assets": [],
            "styles": [],
            "scripts": [],
            "sourceMap": true,
            "optimization": false
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "remote-tool-mock:build",
            "port": 8081
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}