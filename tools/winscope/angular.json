{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "winscope": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/winscope",
            "index": "src/index.html",
            "main": "src/main_dev.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.dev.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              { "glob": "*", "input": "deps_build/trace_processor/to_be_served/", "output": "/" },
              { "glob": "winscope_proxy.py", "input": "src/adb/", "output": "/" },
              { "glob": "logo_page_tab.svg", "input": "src/", "output": "/" },
              { "glob": "logo_light_mode.svg", "input": "src/", "output": "/" },
              { "glob": "logo_dark_mode.svg", "input": "src/", "output": "/" },
              { "glob": "cube_partial_shade.svg", "input": "src/app/shared/rects/", "output": "/" },
              { "glob": "cube_full_shade.svg", "input": "src/app/shared/rects/", "output": "/" },
              {
                "glob": "trackpad_right_click.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              },
              {
                "glob": "trackpad_vertical_scroll.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              },
              {
                "glob": "trackpad_horizontal_scroll.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles/material-theme.scss",
              "src/styles/styles.scss"
            ],
            "scripts": [],
            "sourceMap": true,
            "optimization": false,
            "webWorkerTsConfig": "tsconfig.worker.json",
            "allowedCommonJsDependencies": [
              "jszip",
              "@protos/protos/ime/udc/editorinfo_pb",
              "@protos/protos/ime/udc/inputconnection_pb",
              "google-protobuf/google/protobuf/descriptor_pb",
              "@protos/protos/ime/udc/inputmethodeditortrace_pb",
              "@protos/protos/ime/udc/inputmethodservice_pb",
              "@protos/protos/ime/udc/softinputwindow_pb",
              "@protos/protos/perfetto/common/protolog_common_pb",
              "@protos/protos/perfetto/trace/android/protolog_pb",
              "@protos/protos/perfetto/trace/android/surfaceflinger_layers_pb",
              "@protos/protos/perfetto/trace/android/surfaceflinger_transactions_pb",
              "@protos/protos/perfetto/trace/android/viewcapture_pb",
              "@protos/protos/perfetto/trace/android/winscope_extensions_pb",
              "@protos/protos/perfetto/trace/interned_data/interned_data_pb",
              "@protos/protos/perfetto/trace/profiling/profile_common_pb",
              "@protos/protos/perfetto/trace_processor/metatrace_categories_pb",
              "@protos/protos/perfetto/trace_processor/trace_processor_pb",
              "@protos/protos/perfetto/trace/android/inputmethodeditor_pb",
              "@protos/protos/perfetto/trace/android/inputmethodeditor_pb",
              "@protos/protos/perfetto/trace/android/server/windowmanagerservice_pb",
              "@protos/protos/perfetto/trace/android/shell_transition_pb",
              "@protos/protos/perfetto/trace/android/windowmanager_pb",
              "@protos/protos/perfetto/trace/android/winscope_extensions_impl_pb",
              "@protos/protos/perfetto/trace/clock_snapshot_pb",
              "@protos/protos/perfetto/trace/trace_packet_pb",
              "@protos/protos/perfetto/trace/trace_pb",
              "@protos/protos/protolog/udc/protolog_pb",
              "@protos/protos/surfaceflinger/udc/layerstrace_pb",
              "@protos/protos/transitions/udc/windowmanagertransitiontrace_pb",
              "@protos/protos/transitions/udc/wm_shell_transition_trace_pb",
              "@protos/protos/viewcapture/udc/view_capture_pb",
              "@protos/protos/windowmanager/udc/windowmanagertrace_pb"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/main_dev.ts",
                  "with": "src/main_prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "15mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "tsConfig": "tsconfig.prod.json",
              "outputPath": "dist/prod"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "winscope:build",
            "port": 8080,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "winscope:build:production",
              "port": 8080
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "winscope:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/main_unit_test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.karma.json",
            "karmaConfig": "karma.config.dev.js",
            "styles": [
              "src/styles/material-theme.scss",
              "src/styles/styles.scss"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets",
              { "glob": "**/*", "input": "src/test/fixtures", "output": "/src/test/fixtures" },
              { "glob": "*", "input": "deps_build/trace_processor/to_be_served/", "output": "/" },
              { "glob": "winscope_proxy.py", "input": "src/adb/", "output": "/" },
              { "glob": "logo_page_tab.svg", "input": "src/", "output": "/" },
              { "glob": "logo_light_mode.svg", "input": "src/", "output": "/" },
              { "glob": "logo_dark_mode.svg", "input": "src/", "output": "/" },
              {
                "glob": "cube_partial_shade.svg",
                "input": "src/app/shared/rects/",
                "output": "/"
              },
              {
                "glob": "cube_full_shade.svg",
                "input": "src/app/shared/rects/",
                "output": "/"
              },
              {
                "glob": "trackpad_right_click.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              },
              {
                "glob": "trackpad_vertical_scroll.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              },
              {
                "glob": "trackpad_horizontal_scroll.svg",
                "input": "src/app/shared/shortcuts_panel/",
                "output": "/"
              }
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "ci": {
              "karmaConfig": "karma.config.ci.js",
              "codeCoverage": true
            }
          }
        }
      }
    },
    "remote-tool-mock": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src/test/remote_tool_mock",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/remote_tool_mock",
            "index": "src/test/remote_tool_mock/index.html",
            "main": "src/test/remote_tool_mock/main.ts",
            "polyfills": "src/test/remote_tool_mock/polyfills.ts",
            "tsConfig": "src/test/remote_tool_mock/tsconfig.remote_tool.json",
            "assets": [],
            "styles": [],
            "scripts": [],
            "sourceMap": true,
            "optimization": false
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "remote-tool-mock:build",
            "port": 8081
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}